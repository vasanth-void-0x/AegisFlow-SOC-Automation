# AegisFlow MCP Security Server - isolated from the main backend image
# because the mcp SDK requires a newer starlette than FastAPI supports.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-mcp.txt .
RUN pip install --no-cache-dir -r requirements-mcp.txt

COPY . .

RUN useradd --create-home --shell /bin/bash aegisflow && chown -R aegisflow:aegisflow /app
USER aegisflow

CMD ["python", "-m", "app.mcp_server.server"]
