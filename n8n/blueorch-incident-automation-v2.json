{
  "name": "BlueOrch - Incident Automation V2",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 15
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Poll Every 15 Seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -900,
        120
      ]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -900,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://blueorch-soc-automation.vercel.app/api/v1/incidents",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "new"
            },
            {
              "name": "minimum_severity",
              "value": "medium"
            },
            {
              "name": "page",
              "value": "1"
            },
            {
              "name": "page_size",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-BlueOrch-Automation-Key",
              "value": "={{$env.BLUEORCH_AUTOMATION_KEY}}"
            }
          ]
        }
      },
      "id": "fetch-new-incidents",
      "name": "Fetch Next New Incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -660,
        210
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const page = $input.first().json;\nconst incident = Array.isArray(page.items) ? page.items[0] : null;\nif (!incident) return [];\nreturn [{ json: incident }];"
      },
      "id": "select-next-incident",
      "name": "Select Next Incident",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -420,
        210
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://blueorch-soc-automation.vercel.app/api/v1/incidents/{{$('Select Next Incident').item.json.id}}/status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"status\":\"triaging\"}",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-BlueOrch-Automation-Key",
              "value": "={{$env.BLUEORCH_AUTOMATION_KEY}}"
            }
          ]
        }
      },
      "id": "claim-incident",
      "name": "Claim Incident - Triaging",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        210
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "url": "=https://blueorch-soc-automation.vercel.app/api/v1/incidents/{{$('Select Next Incident').item.json.id}}/enrichment",
        "options": {
          "timeout": 20000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-BlueOrch-Automation-Key",
              "value": "={{$env.BLUEORCH_AUTOMATION_KEY}}"
            }
          ]
        }
      },
      "id": "enrich-incident",
      "name": "AI Investigation - Enrich IOCs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        60,
        210
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://blueorch-soc-automation.vercel.app/api/v1/incidents/{{$('Select Next Incident').item.json.id}}/triage",
        "options": {
          "timeout": 45000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-BlueOrch-Automation-Key",
              "value": "={{$env.BLUEORCH_AUTOMATION_KEY}}"
            }
          ]
        }
      },
      "id": "run-ai-triage",
      "name": "Run Groq AI Triage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        210
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const triage = $input.first().json;\nconst result = triage.result;\nconst incident = $('Select Next Incident').first().json;\nif (!result) {\n  return [{ json: { usable: false, incident_id: incident.id, error: triage.error || 'AI triage returned no result' } }];\n}\nconst severity = String(result.recommended_severity || incident.severity || 'low').toLowerCase();\nconst classification = String(result.classification || 'needs_more_info').toLowerCase();\nlet action_type = null;\nlet target = null;\nif (incident.source_ip) { action_type = 'block_ip'; target = incident.source_ip; }\nelse if (incident.hostname) { action_type = 'isolate_host'; target = incident.hostname; }\nelse if (incident.username) { action_type = 'disable_account'; target = incident.username; }\nconst needs_approval = Boolean(result.requires_human_approval) && classification === 'true_positive' && ['high', 'critical'].includes(severity) && Boolean(target);\nreturn [{ json: {\n  usable: true,\n  incident_id: incident.id,\n  severity,\n  classification,\n  confidence: result.confidence,\n  summary: result.summary,\n  evidence: result.evidence || [],\n  recommended_actions: result.recommended_actions || [],\n  needs_approval,\n  action_type,\n  target,\n  justification: `${result.summary} Confidence: ${Math.round(Number(result.confidence || 0) * 100)}%. Human approval is required before execution.`\n} }];"
      },
      "id": "build-response-plan",
      "name": "Build Investigation Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        210
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.usable}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "triage-usable",
      "name": "Triage Result Usable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        210
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.needs_approval}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "approval-required",
      "name": "Approval Required?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1020,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://blueorch-soc-automation.vercel.app/api/v1/incidents/{{$json.incident_id}}/proposals",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({action_type: $json.action_type, target: $json.target, justification: $json.justification, proposed_by: 'n8n_incident_automation_v2'}) }}",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-BlueOrch-Automation-Key",
              "value": "={{$env.BLUEORCH_AUTOMATION_KEY}}"
            }
          ]
        }
      },
      "id": "create-proposal",
      "name": "Create Pending Response Proposal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1260,
        40
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://blueorch-soc-automation.vercel.app/api/v1/incidents/{{$('Select Next Incident').item.json.id}}/status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"status\":\"pending_approval\"}",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-BlueOrch-Automation-Key",
              "value": "={{$env.BLUEORCH_AUTOMATION_KEY}}"
            }
          ]
        }
      },
      "id": "pending-approval",
      "name": "Send to Approval Centre",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        40
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "resource": "noOp",
        "notes": "AI investigation completed. No automated containment proposal was required; the incident remains available for analyst review."
      },
      "id": "analyst-review",
      "name": "Analyst Review - No Auto Response",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1260,
        200
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://blueorch-soc-automation.vercel.app/api/v1/incidents/{{$json.incident_id}}/status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"status\":\"new\"}",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-BlueOrch-Automation-Key",
              "value": "={{$env.BLUEORCH_AUTOMATION_KEY}}"
            }
          ]
        }
      },
      "id": "release-for-retry",
      "name": "Release Incident for Retry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        340
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "resource": "noOp",
        "notes": "A human now approves or rejects in BlueOrch Approval Centre. Approval immediately triggers the backend's safe response adapter and audit trail; n8n never bypasses this gate."
      },
      "id": "wait-human",
      "name": "Human Approval Gate",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1740,
        40
      ]
    }
  ],
