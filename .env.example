# Copy this file to .env and fill in values as needed.
# AegisFlow runs fully in DEMO_MODE=true with NO keys required.

# --- App ---
APP_NAME=AegisFlow
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:///./aegisflow.db
# For Postgres: postgresql+psycopg2://user:password@localhost:5432/aegisflow

# --- Security ---
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
MAX_REQUEST_BODY_BYTES=1000000
RATE_LIMIT_PER_MINUTE=120

# --- AI / Groq (optional - leave blank to use fallback/demo triage) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROMPT_VERSION=v1

# --- Threat Intel (optional - leave blank to use demo enrichment) ---
VIRUSTOTAL_API_KEY=
ENRICHMENT_CACHE_TTL_SECONDS=3600
ENRICHMENT_TIMEOUT_SECONDS=5.0

# --- RAG ---
VECTOR_DB_PATH=./chroma_data
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_RELEVANCE_THRESHOLD=0.35

# --- Response actions ---
# NEVER set this to true unless you have implemented and reviewed a real
# response adapter. Default is simulated/demo actions only.
ENABLE_REAL_RESPONSE_ADAPTER=false
APPROVAL_EXPIRY_MINUTES=30

# --- MCP ---
MCP_TOOL_TIMEOUT_SECONDS=10.0
