# Copy this file to .env and fill in values as needed.
# BlueOrch dashboard uses real SIEM data only.

# --- App ---
APP_NAME=BlueOrch
ENVIRONMENT=development
DEMO_MODE=false
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:///./blueorch.db
# For Postgres: postgresql+psycopg://user:password@localhost:5432/blueorch

# --- Security ---
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
MAX_REQUEST_BODY_BYTES=1000000
RATE_LIMIT_PER_MINUTE=120

# --- Human authentication / RBAC ---
# Disabled by default so an incomplete configuration cannot lock out a deployment.
AUTH_ENABLED=false
# Required (32+ random characters) when auth is enabled in production.
AUTH_SECRET=
AUTH_SESSION_MINUTES=480
# One-time setup token for POST /api/v1/auth/bootstrap; remove after first admin creation.
AUTH_BOOTSTRAP_TOKEN=

# --- AI / Groq (optional - leave blank to use fallback/demo triage) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROMPT_VERSION=v1

# --- Threat Intel (required for live reputation; failures are reported explicitly) ---
VIRUSTOTAL_API_KEY=
ENRICHMENT_CACHE_TTL_SECONDS=3600
ENRICHMENT_TIMEOUT_SECONDS=5.0

# --- RAG ---
VECTOR_DB_PATH=./chroma_data
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_RELEVANCE_THRESHOLD=0.35

# --- Response actions ---
# NEVER set this to true unless you have implemented and reviewed a real
# response adapter. Default is simulated/demo actions only.
ENABLE_REAL_RESPONSE_ADAPTER=false
APPROVAL_EXPIRY_MINUTES=30

# --- MCP ---
MCP_TOOL_TIMEOUT_SECONDS=10.0
# Shared secret used by remote n8n MCP gateway calls.
MCP_GATEWAY_API_KEY=replace-with-a-different-long-random-secret

# --- SIEM ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIEM_ENCRYPTION_KEY=
SIEM_REQUEST_TIMEOUT_SECONDS=15
SIEM_SYNC_LIMIT=500
# Optional API key required from 24/7 direct-log collectors
DIRECT_LOG_API_KEY=
# Admin-only token used to register/list endpoint collectors.
DIRECT_LOG_REGISTRATION_TOKEN=replace-with-a-long-random-secret

# n8n automation endpoint and shared secret
N8N_WEBHOOK_URL=http://localhost:5678/webhook/blueorch-alert
N8N_WEBHOOK_SECRET=
